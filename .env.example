# Arquivo de exemplo para variáveis de ambiente
# Copie este arquivo para .env: cp .env.example .env

# Chave de API da OpenWeather (https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=sua_chave_openweather_aqui

# Token do Bot do Telegram fornecido pelo @BotFather
TELEGRAM_BOT_TOKEN=seu_token_telegram_bot_aqui

# (Opcional) Chave de API do Google Gemini (Google AI Studio)
GEMINI_API_KEY=sua_chave_gemini_aqui

# (Opcional se rodar localmente com túnel público para Webhooks do Telegram)
WEBHOOK_URL=http://localhost:5678/
